// Meridian Construction Group — data model
// Prisma 7 · PostgreSQL · driver adapter (@prisma/adapter-pg)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core schema)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(EDITOR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  posts    Post[]

  @@map("user")
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

enum Sector {
  RESIDENTIAL
  COMMERCIAL
  HOSPITALITY
  HEALTHCARE
  EDUCATION
  RETAIL
  INDUSTRIAL
  INFRASTRUCTURE
}

enum ProjectStatus {
  CONCEPT
  IN_PROGRESS
  COMPLETED
  HANDED_OVER
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  subtitle    String?
  summary     String
  narrative   String        @db.Text
  sector      Sector
  status      ProjectStatus @default(COMPLETED)
  featured    Boolean       @default(false)
  heroImage   String
  city        String
  country     String
  latitude    Float?
  longitude   Float?
  client      String
  architect   String?
  valueUsd    BigInt?
  areaSqm     Int?
  floors      Int?
  startedAt   DateTime?
  completedAt DateTime?
  awards      String[]      @default([])
  challenges  String        @db.Text
  results     String        @db.Text

  gallery   ProjectImage[]
  milestones ProjectMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sector, featured])
  @@map("project")
}

enum ImageKind {
  PHOTO
  DRONE
  BLUEPRINT
  FLOOR_PLAN
  PROGRESS
  BEFORE
  AFTER
  PANORAMA_360
}

model ProjectImage {
  id       String    @id @default(cuid())
  url      String
  alt      String
  kind     ImageKind @default(PHOTO)
  caption  String?
  width    Int?
  height   Int?
  position Int       @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
  @@map("project_image")
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  label       String
  description String?
  occurredAt  DateTime
  position    Int       @default(0)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_milestone")
}

// ---------------------------------------------------------------------------
// Editorial
// ---------------------------------------------------------------------------

enum PostCategory {
  CONSTRUCTION_NEWS
  ARCHITECTURE
  ENGINEERING
  TECHNOLOGY
  SUSTAINABILITY
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String
  body        String       @db.Text
  coverImage  String
  category    PostCategory
  readMinutes Int          @default(5)
  published   Boolean      @default(false)
  publishedAt DateTime?

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, published])
  @@map("post")
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
}

model JobPosting {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  department  String
  location    String
  country     String
  type        EmploymentType @default(FULL_TIME)
  seniority   String
  summary     String
  description String         @db.Text
  requirements String[]      @default([])
  active      Boolean        @default(true)
  postedAt    DateTime       @default(now())

  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department, active])
  @@map("job_posting")
}

model JobApplication {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  linkedinUrl String?
  resumeUrl   String?
  coverLetter String?  @db.Text
  createdAt   DateTime @default(now())

  jobId String
  job   JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_application")
}

// ---------------------------------------------------------------------------
// Commercial enquiries
// ---------------------------------------------------------------------------

enum InquiryIntent {
  GENERAL
  QUOTE
  SITE_VISIT
  CONSULTATION
  PARTNERSHIP
  PRESS
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  ARCHIVED
}

model Inquiry {
  id          String        @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  company     String?
  country     String?
  intent      InquiryIntent @default(GENERAL)
  projectType String?
  budgetBand  String?
  timeline    String?
  message     String        @db.Text
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
  @@map("inquiry")
}

model NewsletterSubscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  confirmed    Boolean   @default(false)
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@map("newsletter_subscriber")
}
