# ---------------------------------------------------------------------------
# Meridian Construction Group — environment
# Copy to `.env` and fill in. Every value is optional for local UI work;
# the marketing site renders fully from typed static data without a database.
# ---------------------------------------------------------------------------

# Public site origin — used for canonical URLs, OpenGraph and sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL (Prisma 7 + @prisma/adapter-pg)
DATABASE_URL="postgresql://user:password@localhost:5432/meridian?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Cloudinary — media delivery for project galleries
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Anthropic — powers the AI construction assistant (/api/assistant).
# Leaving this blank is supported: the assistant answers from the site's own
# services, projects, offices and cost model instead of calling Claude.
ANTHROPIC_API_KEY=""
